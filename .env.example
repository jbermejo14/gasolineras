# URL base para canonicals, open graph y sitemap (sin barra final)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Base de las particiones de histórico por gasolinera que lee el navegador.
# Si se deja sin definir, se usan los ficheros de public/ bajo la ruta base de la web.
# Para un bucket externo, su URL pública con el prefijo estaciones (p. ej. https://datos.ejemplo.com/estaciones).
#NEXT_PUBLIC_HISTORICO_BASE_URL=

# Subida a Cloudflare R2 con `npm run historico -- --subir` (solo necesarias para subir)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Identificador de editor de Google AdSense (ca-pub- y 16 dígitos).
# Vacío por defecto: sin AdSense y sin botón "Configurar cookies".
NEXT_PUBLIC_ADSENSE_CLIENT=
